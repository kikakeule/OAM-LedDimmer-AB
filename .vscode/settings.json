{
    "C_Cpp.default.configurationProvider": "platformio.platformio-ide",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-arm",
    "C_Cpp.intelliSenseEngine": "default",
    "clangd.enable": false,
    "files.associations": {
        "cstdint": "cpp",
        "ostream": "cpp",
        "cmath": "cpp",
        "*.tcc": "cpp",
        "compare": "cpp",
        "random": "cpp",
        "format": "cpp",
        "mutex": "cpp",
        "numeric": "cpp",
        "ratio": "cpp",
        "array": "cpp",
        "type_traits": "cpp",
        "variant": "cpp"
    },
    "platformio-ide.autoRebuildAutocompleteIndex": true,
    "idf.portWin": "COM43"
}